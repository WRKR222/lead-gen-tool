# Example nginx reverse proxy in front of the app (VPS/Docker deployment).
# Get a free TLS cert first: certbot --nginx -d leadgen.yourdomain.com
#
# Copy to /etc/nginx/sites-available/leadgen.conf and symlink into
# sites-enabled, then `nginx -t && systemctl reload nginx`.

server {
    listen 80;
    server_name leadgen.yourdomain.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name leadgen.yourdomain.com;

    ssl_certificate     /etc/letsencrypt/live/leadgen.yourdomain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/leadgen.yourdomain.com/privkey.pem;

    # Basic hardening
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Simple request rate limit - protects the /discover and /send
    # endpoints (which call paid third-party APIs) from abuse.
    limit_req_zone $binary_remote_addr zone=leadgen_limit:10m rate=10r/s;
    limit_req zone=leadgen_limit burst=20 nodelay;

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
