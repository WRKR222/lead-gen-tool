# ---- Zero-cost local demo mode ----
# Set to true to force fake data + local generation for EVERY AI feature
# (leads, emails, call scripts, company profiling, content studio) even if
# real API keys happen to be present. Leave unset/false once you have real
# keys - each service already falls back to mock/local behavior
# independently when its own specific key is simply missing, so
# MOCK_MODE=true is only needed to force demo behavior on top of real keys
# (e.g. to avoid burning paid credits while testing UI changes).
MOCK_MODE=false

# ---- Server ----
PORT=4000
# Public URL used to build working unsubscribe links and (later) OAuth
# redirect URIs. Must match your real deployed URL in production.
PUBLIC_BASE_URL=http://localhost:4000

# ---- Auth ----
# Long random string - `openssl rand -hex 32`. Required in production;
# every login/session token is signed with this.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# ---- Company AI profiling + email generation + call scripts + content studio ----
# One key powers: onboarding (turns a company's description into its ICP/
# geo/scoring/outreach/brand profile), per-lead unique cold emails, AI
# call scripts, the AI sales assistant, and text content generation
# (pitches/ad copy/social plans).
ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional. Code default is claude-opus-5. For claude-opus-5 / claude-fable-5-1
# a server-side refusal fallback is enabled; set ANTHROPIC_FALLBACKS=off to disable.
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_FALLBACKS=on

# ---- Lead sourcing: Clay (https://clay.com) ----
# Get from Clay workspace settings -> API. Confirm exact auth header/endpoint
# in Clay's current developer docs, these change over time.
CLAY_API_KEY=your_clay_api_key
CLAY_WORKSPACE_ID=your_clay_workspace_id
CLAY_API_BASE=https://api.clay.com/v3
DISABLE_CLAY=false

# ---- Lead sourcing: Explorium / Vibe Prospecting ----
# Vibe Prospecting is Explorium's MCP-based prospecting layer. For direct
# (non-MCP) server-to-server use, use your Explorium API key. Confirm the
# current base URL/auth scheme in Explorium's developer docs.
EXPLORIUM_API_KEY=your_explorium_api_key
EXPLORIUM_API_BASE=https://api.explorium.ai/v1
DISABLE_EXPLORIUM=false

# ---- Lead sourcing: web research (search + AI extraction) ----
# Not scraping - uses a licensed search API to find public pages/snippets,
# then an LLM (ANTHROPIC_API_KEY above) extracts structured facts. Choose
# one provider:
SEARCH_PROVIDER=serpapi
SERPAPI_API_KEY=your_serpapi_key
# SEARCH_PROVIDER=bing
BING_SEARCH_API_KEY=your_bing_search_key
DISABLE_WEB_RESEARCH=false

# ---- Email sending (bulk cold email) ----
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASS=your_smtp_password
FROM_NAME="Your Company"
FROM_EMAIL=you@yourdomain.com

# ---- Sending limits (compliance / deliverability guardrails) ----
MAX_EMAILS_PER_HOUR=100
MAX_EMAILS_PER_DAY=500

# ---- Domain warm-up ramp (per company) ----
# On a brand-new sending domain, daily volume ramps linearly from
# WARMUP_START_PER_DAY up to MAX_EMAILS_PER_DAY over WARMUP_RAMP_DAYS,
# instead of allowing full volume immediately. Set WARMUP_ENABLED=false
# once a company's domain has an established sending reputation.
WARMUP_ENABLED=true
WARMUP_START_PER_DAY=20
WARMUP_RAMP_DAYS=21

# ---- Graphics generation ----
IMAGE_PROVIDER=mock
# IMAGE_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key
OPENAI_IMAGE_MODEL=gpt-image-1

# ---- Video ad generation ----
# Generic job-submission video API shape (submit prompt -> job id -> poll
# for a result URL). Point this at whichever provider you have access to
# (e.g. a Sora-style API, Veo, Runway, Pika) - see videoGenerationService.js
# for the exact request shape to adjust to that provider's current docs.
VIDEO_API_BASE=
VIDEO_API_KEY=
VIDEO_MODEL=default

# ---- Calendar sync (optional - meetings work via downloadable .ics with
# zero configuration; set these only to also push to Google Calendar) ----
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# ---- AI assistant autonomous mode ----
# Off by default. When true, an in-process loop runs the AI assistant for
# every onboarded company on an interval so it can proactively create
# follow-up tasks etc. without anyone clicking a button. For production,
# prefer triggering POST /api/assistant/run-autonomous per company from an
# external scheduler instead, for better control/observability.
AUTONOMOUS_ASSISTANT_ENABLED=false
AUTONOMOUS_ASSISTANT_INTERVAL_MINUTES=60

# ---- Agency platform (v3) ----
# After Chunguza registers its agency workspace, set to false so no one else
# can create an agency (clients still sign up with the agency link).
ALLOW_AGENCY_SIGNUP=true

# Follow-up cadence engine: sends due follow-up emails (when the workspace
# enables auto follow-ups) and creates tasks for door-to-door/call/DM touches.
FOLLOWUP_ENGINE_ENABLED=true
FOLLOWUP_ENGINE_INTERVAL_MINUTES=30

# ---- Live replies from leads (pick one) ----
# A) Poll the mailbox leads reply to. Leave IMAP_HOST empty to disable.
#    IMAP_WORKSPACE_ID defaults to the agency workspace, whose inbox also
#    matches replies from its clients' leads.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
IMAP_WORKSPACE_ID=
IMAP_POLL_MINUTES=2
# B) Or point your provider's inbound webhook (Postmark inbound, Mailgun
#    routes, any JSON forwarder) at the URL shown in Settings:
#    POST {PUBLIC_BASE_URL}/api/inbound/email/<workspace inbound token>

# ---- Appointment tools ----
# HighLevel private integration token + location (contact upsert).
HIGHLEVEL_API_KEY=
HIGHLEVEL_LOCATION_ID=
HIGHLEVEL_API_BASE=https://services.leadconnectorhq.com
# Appointwise inbound webhook (a per-workspace URL in Settings overrides this).
APPOINTWISE_WEBHOOK_URL=

# ---- Keep data on hosts without a persistent disk (Render free plan) ----
# Litestream (downloaded by npm install) restores the SQLite database on start
# and streams every change to S3-compatible storage. Backblaze B2 has a free
# tier: create a private bucket + an application key for it.
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=https://s3.us-west-004.backblazeb2.com
LITESTREAM_REGION=us-west-004
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
# LITESTREAM_PATH=chunguza/leadgen
